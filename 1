  <script>
    // Logika Popup 
    const projects = [
      { images: ["atcs.jpg"], github: "#contact" },
      { images: ["reservasi (1).png", "reservasi (2).png", "reservasi (3).png", "reservasi (4).png"], github: "https://github.com/fuddin6/Sistem-Manajemen-Reservasi" },
      { images: ["bnsp.jpg", "bnsp2.jpg"], github: "#contact" },
      { images: ["cisco.png"], github: "#contact" },
      { images: ["software_engineering.jpg"], github: "https://github.com/fuddin6/CodingCamp-220925-Muhamad-Nur-Saifuddin" },
      { images: ["toefl.png"], github: "#contact" },
    ];

    let currentProject = 0;
    let currentImageIndex = 0;
    const popupElement = document.getElementById('popup');

    function openPopup(index) {
      currentProject = index;
      currentImageIndex = 0;
      popupElement.style.display = 'flex'; 
      setTimeout(() => {
        popupElement.classList.add('open');
      }, 10); 
      updatePopup();
    }

    function closePopup() {
      popupElement.classList.remove('open');
      setTimeout(() => {
          popupElement.style.display = 'none';
      }, 400); 
    }

    function updatePopup() {
      const popupImage = document.getElementById('popupImage');
      const githubLink = document.getElementById('githubLink');
      const prevButton = document.querySelector('.controls button:first-child');
      const nextButton = document.querySelector('.controls button:last-child');

      if (projects[currentProject].images.length > 1) {
          prevButton.style.display = 'inline-block';
          nextButton.style.display = 'inline-block';
      } else {
          prevButton.style.display = 'none';
          nextButton.style.display = 'none';
      }
      
      popupImage.src = projects[currentProject].images[currentImageIndex];
      githubLink.href = projects[currentProject].github;
      
      if (projects[currentProject].github.includes("github.com")) {
        githubLink.textContent = "Lihat Code di GitHub";
      } else if (projects[currentProject].github.includes("#contact")) {
        githubLink.textContent = "Hubungi Saya untuk Detail";
      } else {
        githubLink.textContent = "Lihat Detail (Link Eksternal)";
      }
    }

    function nextImage() {
      currentImageIndex = (currentImageIndex + 1) % projects[currentProject].images.length;
      updatePopup();
    }

    function prevImage() {
      currentImageIndex = (currentImageIndex - 1 + projects[currentProject].images.length) % projects[currentProject].images.length;
      updatePopup();
    }
    
    // Logika Fade-In Section
    document.addEventListener('DOMContentLoaded', (event) => {
      const sections = document.querySelectorAll('.hero, section');
      sections.forEach((section, index) => {
          setTimeout(() => {
            section.classList.add('loaded');
          }, 100 * (index + 1)); 
      });

      // INISIALISASI CAROUSEL GAMBAR WAJAH
      startPhotoCarousel();
    });


    // FUNGSI CAROUSEL GAMBAR WAJAH
    function startPhotoCarousel() {
        const carousel = document.getElementById('heroPhotoCarousel');
        const images = carousel.querySelectorAll('img');
        let currentPhotoIndex = 0;
        const totalPhotos = images.length;

        function nextPhoto() {
            // Sembunyikan gambar saat ini
            images[currentPhotoIndex].classList.remove('active');
            
            // Pindah ke gambar berikutnya
            currentPhotoIndex = (currentPhotoIndex + 1) % totalPhotos;
            
            // Tampilkan gambar berikutnya
            images[currentPhotoIndex].classList.add('active');
        }

        // Ganti gambar setiap 4 detik (4000 milidetik)
        setInterval(nextPhoto, 4000); 
    }
  </script>

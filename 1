    }

    .hero, section {
      opacity: 0; 
      transform: translateY(20px); 
      transition: opacity 0.8s ease-out, transform 0.8s ease-out; 
    }
    
    .hero.loaded, section.loaded {
      opacity: 1;
      transform: translateY(0);
    }
    
    .hero {

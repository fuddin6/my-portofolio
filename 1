        height: 150px;
        overflow: hidden;
        border-radius: 50%;
        border: 4px solid #00bfff;
        margin-bottom: 25px;
        position: relative;
    }

    .hero-photo-carousel img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        top: 0;
        left: 0;
        opacity: 0;
        transition: opacity 1s ease-in-out; 
    }

    .hero-photo-carousel img.active {

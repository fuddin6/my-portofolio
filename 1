      margin: 15px 0;
      color: #ccc;
    }

    .hero button {
      background: #00bfff;
      color: #fff;
      border: none;
      padding: 10px 25px;
      font-size: 1em;
      border-radius: 25px;
      cursor: pointer;
      transition: background 0.3s ease;
    }

    .hero button:hover {
      background: #009acd;
    }

    section {
      padding: 60px 50px;
      max-width: 1000px;
      margin: auto;
    }

    h3.section-title {
      font-size: 1.8em;
      color: #00bfff;
      text-align: center;
      margin-bottom: 30px;
    }

    .about p {
      text-align: center;
      color: #ccc;
      font-size: 1.1em;
    }

    .skills-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 15px;
    }

    .skill {
      background: #111;
      padding: 10px 20px;
      border: 1px solid #00bfff;
      border-radius: 20px;
      color: #fff;
      transition: background 0.3s ease, color 0.3s ease;
    }

    .skill:hover {
      background: #00bfff;
      color: #0d0d0d;
    }

    .project-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }

    .project {
      background: #111;
      padding: 20px;
      border-radius: 10px;
      transition: transform 0.3s ease, border 0.3s ease;
      cursor: pointer;
    }

    .project:hover {
      transform: translateY(-5px);
      border: 1px solid #00bfff;
    }

    .project h4 {
      color: #00bfff;
      margin-bottom: 10px;
    }

    footer {
      text-align: center;
      padding: 20px;
      border-top: 1px solid #222;
      color: #999;
      font-size: 0.9em;
    }

    .popup {
      display: none; 
      position: fixed;
      z-index: 999;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.9);
      align-items: center;
      justify-content: center;
      flex-direction: column;
      
      opacity: 0; 
      visibility: hidden; 
      transition: opacity 0.4s ease, visibility 0.4s ease; 
    }
    
    .popup.open {
        visibility: visible;
        opacity: 1;
    }

    .popup img {
      width: 80%;
      max-width: 600px;
      border-radius: 10px;
    }

    .popup .controls {
      margin-top: 15px;
      display: flex;
      justify-content: center;
      gap: 20px;
    }

    .popup button {
      background: #00bfff;
      border: none;
      color: white;
      padding: 8px 15px;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.3s ease;
    }

    .popup button:hover {
      background: #009acd;
    }

    .popup a {
      margin-top: 20px;
      color: #00bfff;
      text-decoration: none;
    }

    .close-btn {
      position: absolute;
      top: 20px;
      right: 30px;
      color: #fff;
      font-size: 2em;
      cursor: pointer;
      transition: color 0.3s ease;
    }
    
    .close-btn:hover {
        color: #00bfff;
    }

    /* Responsif */
    @media (max-width: 768px) {
      header {
        flex-direction: column;
        text-align: center;
      }

      nav {
        margin-top: 10px;
      }

      .hero h2 {
        font-size: 2em;
      }
    }
  </style>
</head>

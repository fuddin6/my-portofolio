  <style>
    /* Styling yang sudah DIBERSIHKAN dari karakter yang tidak valid */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Poppins', sans-serif;
    }
    body {
      background-color: #0d0d0d;
      color: #f1f1f1;
      line-height: 1.6;
    }

    header {
      background: #111;
      padding: 20px 50px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    header h1 {
